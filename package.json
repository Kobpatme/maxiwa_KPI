{
  "name": "metrixverity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/logic-tests.mjs && node scripts/performance-tests.mjs && node scripts/performance-admin-tests.mjs",
    "test:logic": "node scripts/logic-tests.mjs",
    "test:build": "node scripts/build-tests.mjs",
    "dev": "npm run build && node local-dev-server.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name metrixverity",
    "test:performance": "node scripts/performance-tests.mjs",
    "test:performance:browser": "node scripts/performance-browser-tests.mjs",
    "test:performance:admin": "node scripts/performance-admin-tests.mjs"
  },
  "devDependencies": {
    "esbuild": "0.27.3",
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.10.0"
  },
  "dependencies": {
    "iconv-lite": "^0.7.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
